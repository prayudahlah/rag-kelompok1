# Salin menjadi .env (jangan di-commit) untuk build/run image secara lokal.
# Di Render, isi lewat menu Environment, bukan file ini.

# Google Gemini API key (embedding query + generation).
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional: override lokasi tabel LanceDB (default: ../ingestion/data/lancedb
# relatif terhadap cwd server).
# LANCEDB_PATH=
# LANCEDB_TABLE=pdp_corpus
