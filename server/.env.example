# Port HTTP server
PORT=3000

# Google Gemini (untuk embedding query + generation)
# API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Lokasi tabel LanceDB (relatif terhadap folder server/).
# Ingestion menulis ke ingestion/data/lancedb.
LANCEDB_PATH=../ingestion/data/lancedb
LANCEDB_TABLE=pdp_corpus

# Model generation
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Potong riwayat percakapan ke N pesan terakhir demi hemat token.
CHAT_MAX_HISTORY_TURNS=6

# Query rewriting untuk multi-turn (1 = aktif, 0 = nonaktif).
QUERY_REWRITE=1
